# ==========================================
# PRIMECAPITAL - ENVIRONMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------
SUPABASE_ENABLED=true
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key


# ------------------------------------------
# GNANI AI - ASR (SPEECH TO TEXT)
# ------------------------------------------
GNANI_ASR_URL=your_gnani_asr_endpoint


# ------------------------------------------
# GNANI AI - TTS (TEXT TO SPEECH)
# ------------------------------------------
GNANI_TTS_URL=your_gnani_tts_endpoint


# ------------------------------------------
# GNANI AI - EVON (LANGUAGE MODEL)
# ------------------------------------------
EVON_BACKEND=api
EVON_HF_MODEL_ID=gnani/gnani-evon-v3.3-30B-A3B
EVON_CHAT_COMPLETIONS_URL=your_evon_chat_completions_endpoint
EVON_API_KEY=your_gnani_api_key


# ------------------------------------------
# TELEGRAM BOT CONFIGURATION
# ------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token


# ------------------------------------------
# APPLICATION CONFIGURATION
# ------------------------------------------
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
